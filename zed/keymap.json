// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor",
    "bindings": {
      "ctrl-alt-left": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "left",
          "focus": true
        }
      ]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-alt-right": [
        "workspace::MoveItemToPaneInDirection",
        {
          "direction": "right",
          "focus": true
        }
      ]
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-<": "workspace::ToggleBottomDock"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-g": "git::Diff"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-tab": "tab_switcher::Toggle"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-tab": [
        "tab_switcher::Toggle",
        {
          "select_last": true
        }
      ]
    }
  },
  {
    "context": "Pane",
    "bindings": {
      "ctrl-shift-tab": "pane::ActivatePreviousItem",
      "ctrl-tab": "pane::ActivateNextItem"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-b": "agent::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-?": "agent::ToggleFocus"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-b": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "Workspace",
    "unbind": {
      "cmd-r": "workspace::ToggleRightDock"
    }
  },
  {
    "context": "BufferSearchBar",
    "bindings": {
      "cmd-shift-f": "text_finder::Toggle"
    }
  },
  {
    "context": "BufferSearchBar",
    "unbind": {
      "alt-cmd-f": "text_finder::Toggle"
    }
  },
  {
    "bindings": {
      "cmd-shift-f": "text_finder::Toggle"
    }
  },
  {
    "context": "Editor && mode == full",
    "unbind": {
      "alt-cmd-f": "text_finder::Toggle"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "cmd-/": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ]
    }
  },
  {
    "context": "Editor",
    "unbind": {
      "cmd-´": [
        "editor::ToggleComments",
        {
          "advance_downwards": false
        }
      ]
    }
  }
]
